{
  "name": "opensource-scout-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p frontend/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "password:hash": "node scripts/hash-password.mjs",
    "backup": "node --env-file-if-exists=.env dist/server/backup.js",
    "backup:verify": "node dist/server/verify-backup.js",
    "restore": "node dist/server/restore.js",
    "capacity:probe": "node scripts/capacity-probe.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.8",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.13"
  }
}
