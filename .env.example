NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://scout.example.com
# Generate through stdin with npm run password:hash; quote to preserve dollar signs.
ADMIN_PASSWORD_HASH='scrypt$REPLACE_WITH_GENERATED_HASH'
SESSION_HOURS=12
DB_PATH=/var/lib/scout/scout.sqlite
# M1 uses the fixed DeepSeek HTTPS endpoint. Set model ID in the settings page.
# GitHub credentials are optional for public repositories. Model key is required.
# Never commit actual values; use minimum read-only GitHub permissions.
GITHUB_TOKEN=
MODEL_API_KEY=
# M3 storage ceilings; reaches quota -> reject new work, never silently delete reports.
MAX_DATABASE_BYTES=536870912
MAX_ARTIFACT_TOTAL_BYTES=67108864
MAX_TASKS=1000
MAX_PLANS_PER_TASK=20
MAX_PUBLICATIONS=1000
MAX_BACKUPS=7
# M4 independent persisted UTC-day probe budget; changing requires restart.
MODEL_TEST_DAILY_CALLS=5
MODEL_TEST_DAILY_TOKENS=10000
MODEL_TEST_INTERVAL_MS=60000
# M5 hard ceilings (can be tightened; profile settings stay within these ceilings).
# Daily scheduling and model evaluation are OFF until explicitly enabled in the UI.
DISCOVERY_HARD_MAX_REPOS=20
DISCOVERY_HARD_MAX_ISSUES=200
DISCOVERY_HARD_HTTP_ATTEMPTS=100
DISCOVERY_HARD_DAILY_HTTP=500
DISCOVERY_HARD_TIMEOUT_MS=30000
